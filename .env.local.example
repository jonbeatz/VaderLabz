# =============================================================================
# {PROFILE_NAME} — Environment (copy to .env.local)
# Bootstrap merges JonBeatz master keys automatically. NEVER commit .env.local.
# Full registry: ENV-VARS-REFERENCE.md
# =============================================================================

# Mem0 — isolated per project
MEM0_USER_ID={PROFILE_SLUG}
MEM0_COLLECTION={PROFILE_SLUG}_memories
MEM0_QDRANT_PATH=%USERPROFILE%\.mem0\qdrant_{PROFILE_SLUG}
MEM0_API_KEY=REPLACE_WITH_MEM0_API_KEY
MEM0_LM_MODEL={MEM0_MODEL}
MEM0_JSON_SCHEMA=false

# Hermes profile
HERMES_PROFILE_NAME={PROFILE_NAME}
HERMES_PROFILE_SLUG={PROFILE_SLUG}

# DeepSeek / LiteLLM / ngrok — see JonBeatz master or ENV-VARS-REFERENCE.md
# TELEGRAM_* / MCP tokens / HOSTINGER_* / DRAVEN_* — merged on bootstrap

# Hostinger site paths (set before first deploy)
{PROFILE_ENV_PREFIX}_DOMAIN={PROFILE_SLUG}.dev
{PROFILE_ENV_PREFIX}_WEB_ROOT=REPLACE_WITH_REMOTE_WEB_ROOT
{PROFILE_ENV_PREFIX}_APP_ROOT=REPLACE_WITH_REMOTE_APP_ROOT
{PROFILE_ENV_PREFIX}_DEPLOY_METHOD=hostinger-node
FTP_REMOTE_PATH=/nodejs/{PROFILE_SLUG}

# Backup
PROFILE_BACKUP_ROOT=G:\Hermes_Project_BackUpz\{PROFILE_NAME}

# Voice
DRAVEN_VOICE=edge
DRAVEN_VOICE_FALLBACK=omnivoice
DRAVEN_EDGE_VOICE=en-CA-LiamNeural
DRAVEN_VOICE_POLICY=ritual
DRAVEN_VOICE_ERRORS=1
